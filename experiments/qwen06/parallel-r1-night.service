[Unit]
Description=Resume Parallel-R1 S1/S2 queue in tmux after boot
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/parallel-r1
Environment=HOME=/home/ubuntu
Environment=PARALLEL_R1_ROOT=/home/ubuntu/parallel-r1
ExecStart=/bin/bash /home/ubuntu/parallel-r1/repo/experiments/qwen06/launch_night.sh
RemainAfterExit=yes
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
